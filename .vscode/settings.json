{
  "css.customData": [
    "./.vscode/tailwind-css-data.json"
  ],
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "task.allowAutomaticTasks": true,
  "debug.openDebug": "neverOpen",
  "terminal.integrated.inheritEnv": false,
  "tasks": {
    "label": "lint on open",
    "type": "shell",
    "command": "npm run lint",
    "runOn": "folderOpen"
  }
}
